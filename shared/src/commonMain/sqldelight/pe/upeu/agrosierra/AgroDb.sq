CREATE TABLE lote (
    id INTEGER NOT NULL PRIMARY KEY,
    codigo TEXT NOT NULL,
    nombre TEXT NOT NULL,
    hectareas REAL NOT NULL,
    cultivo TEXT NOT NULL,
    valle TEXT NOT NULL,
    campaniaCerrada INTEGER NOT NULL,
    dosisMaxima REAL NOT NULL
);

CREATE TABLE labor (
    ownerId INTEGER NOT NULL,
    id INTEGER NOT NULL,
    loteId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    fecha TEXT NOT NULL,
    responsable TEXT NOT NULL,
    cantidad REAL NOT NULL,
    observacion TEXT NOT NULL,
    pendiente INTEGER NOT NULL,
    operacionPendiente TEXT,
    creadoEpochMs INTEGER,
    motivoRechazo TEXT,
    PRIMARY KEY (ownerId, id),
    FOREIGN KEY (loteId) REFERENCES lote(id) ON DELETE RESTRICT
);

-- Las filas de la versión anterior quedan en cuarentena, sin atribuirlas a un usuario.
CREATE TABLE labor_legacy (
    id INTEGER NOT NULL PRIMARY KEY,
    loteId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    fecha TEXT NOT NULL,
    responsable TEXT NOT NULL,
    cantidad REAL NOT NULL,
    observacion TEXT NOT NULL,
    pendiente INTEGER NOT NULL
);

CREATE TABLE sync_meta (
    clave TEXT NOT NULL PRIMARY KEY,
    instanteEpochMs INTEGER NOT NULL
);

listarTodos:
SELECT * FROM lote ORDER BY codigo;

listarIdsLotes:
SELECT id FROM lote ORDER BY id;

filtrarLotes:
SELECT * FROM lote
WHERE (:valle IS NULL OR valle = :valle)
  AND (:estado IS NULL OR campaniaCerrada = :estado)
  AND (:busqueda = '' OR lower(codigo) LIKE '%' || lower(:busqueda) || '%'
       OR lower(nombre) LIKE '%' || lower(:busqueda) || '%')
ORDER BY codigo;

obtenerLote:
SELECT * FROM lote WHERE id = ?;

insertarLote:
INSERT OR IGNORE INTO lote
(id, codigo, nombre, hectareas, cultivo, valle, campaniaCerrada, dosisMaxima)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

actualizarLote:
UPDATE lote SET codigo = ?, nombre = ?, hectareas = ?, cultivo = ?, valle = ?,
    campaniaCerrada = ?, dosisMaxima = ? WHERE id = ?;

borrarLotes:
DELETE FROM lote
WHERE NOT EXISTS (SELECT 1 FROM labor WHERE labor.loteId = lote.id)
  AND NOT EXISTS (SELECT 1 FROM labor_legacy WHERE labor_legacy.loteId = lote.id);

obtenerUltimaSincronizacion:
SELECT instanteEpochMs FROM sync_meta WHERE clave = 'lotes';

guardarUltimaSincronizacion:
INSERT OR REPLACE INTO sync_meta (clave, instanteEpochMs) VALUES ('lotes', ?);

observarUltimaSincronizacionLabor:
SELECT instanteEpochMs FROM sync_meta WHERE clave = 'labores:' || :ownerId;

guardarUltimaSincronizacionLabor:
INSERT OR REPLACE INTO sync_meta (clave, instanteEpochMs) VALUES ('labores:' || :ownerId, :instanteEpochMs);

observarLaboresPorLote:
SELECT * FROM labor WHERE ownerId = :ownerId AND loteId = :loteId ORDER BY fecha DESC, id DESC;

obtenerLabor:
SELECT * FROM labor WHERE ownerId = :ownerId AND id = :id;

-- Los IDs locales decrecen al crearse: ante el mismo instante, -1 se envía antes que -2.
listarPendientes:
SELECT * FROM labor WHERE ownerId = :ownerId AND pendiente = 1 ORDER BY creadoEpochMs, id DESC;

contarPendientes:
SELECT COUNT(*) FROM labor WHERE ownerId = :ownerId AND pendiente = 1;

insertarLabor:
INSERT OR REPLACE INTO labor
(ownerId, id, loteId, tipo, fecha, responsable, cantidad, observacion, pendiente, operacionPendiente, creadoEpochMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

borrarLabor:
DELETE FROM labor WHERE ownerId = :ownerId AND id = :id;

borrarSincronizadasDelLote:
DELETE FROM labor WHERE ownerId = :ownerId AND loteId = :loteId AND pendiente = 0;

borrarSincronizadasDeCuenta:
DELETE FROM labor WHERE ownerId = :ownerId AND pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM labor WHERE ownerId = ?;

contarLaboresLegadas:
SELECT COUNT(*) FROM labor_legacy;

contarInciertos:
SELECT COUNT(*) FROM labor WHERE ownerId = :ownerId AND operacionPendiente = 'CREAR_INCIERTO';

contarRechazadas:
SELECT COUNT(*) FROM labor WHERE ownerId = :ownerId AND pendiente = 1 AND motivoRechazo IS NOT NULL;

registrarRechazo:
UPDATE labor SET motivoRechazo = :motivo WHERE ownerId = :ownerId AND id = :id AND pendiente = 1;
